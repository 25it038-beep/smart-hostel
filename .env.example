# Smart Hostel IoT Environment Configuration

# Backend Database (SQLite for dev, easily swapped to PostgreSQL for production)
DATABASE_URL=sqlite:///./smart_hostel.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_hostel

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Device Security
DEVICE_API_KEY=hostel_secret_device_token_2026

# Frontend API Base URL (used in frontend .env)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
